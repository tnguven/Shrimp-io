{
  "name": "@shrimp/root",
  "version": "1.0.0",
  "description": "url shortening application example",
  "main": "index.js",
  "author": "Tan Guven: tanguven@gmail.com",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "pnpm lerna run build --concurrency=2",
    "dev": "docker compose -f docker-compose.dev.yml up -d && lerna run dev --parallel",
    "dev:server": "docker compose -f docker-compose.dev.yml up -d && pnpm lerna run dev --scope=@shrimp/api",
    "test": "lerna run test --stream",
    "e2e": "lerna run --scope @shrimp/client cypress",
    "e2e:headless": "lerna run --scope @shrimp/client cypress:headless",
    "lint": "lerna run lint --concurrency 2",
    "clean": "lerna run clean --stream --concurrency 2",
    "clean-all": "lerna run clean-all --stream --concurrency 2 && yarn clean-workspace",
    "clean-workspace": "rimraf yarn-error.log node_modules",
    "diff": "lerna diff"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "cypress": "^13.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "lerna": "^8.1.9",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}

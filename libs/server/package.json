{
  "name": "@shrimp/api",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "pnpm run build:dev && NODE_ENV=development node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "pnpm run eslint src --ext ts,tsx && pnpm run typecheck",
    "typecheck": "tsc --skipLibCheck",
    "clean": "rimraf globalConfig.json dist *.tsbuildinfo",
    "clean-all": "pnpm run clean && rimraf node_modules types",
    "build:dev": "webpack --config webpack.config.js --mode development",
    "build:prod": "webpack --config webpack.config.js --mode production",
    "build:analyze": "webpack --config webpack.config.js --mode production --analyze",
    "ts-types": "tsc --emitDeclarationOnly --outDir ./libs/server/dist",
    "db:index": "sh scripts/create-db-index.sh"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.0.0",
    "http-status": "^2.1.0",
    "joi": "^17.13.3",
    "mongodb": "^6.12.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "ramda": "^0.30.1",
    "uuid": "^11.0.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/ramda": "^0.30.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vitest-mongodb": "^1.0.0",
    "webpack": "^5.97.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}
